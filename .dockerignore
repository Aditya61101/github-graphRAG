# Only backend source and locked dependency inputs enter the build context.
**
!Dockerfile
!.dockerignore
!backend/
!backend/pyproject.toml
!backend/uv.lock
!backend/api_services/
!backend/api_services/**
!backend/ai_services/
!backend/ai_services/**
!backend/shared/
!backend/shared/**

# Exclusions below override the source-directory inclusions.
**/.env
**/.env.*
**/*.env
**/secrets/**
**/credentials/**
**/*credentials*.json
**/token.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite*
**/data/**
**/repos/**
**/clones/**
**/repositories/**
**/.git/**
**/.venv/**
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.cache/**
**/.pytest_cache/**
**/.ruff_cache/**
**/.mypy_cache/**
**/.state/**
**/*.jsonl
**/*.log
**/*.zip
**/tests/**
**/build/**
**/dist/**
**/*.egg-info/**
