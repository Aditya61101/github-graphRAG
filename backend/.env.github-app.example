# Secret-free template. Copy values into your untracked backend/.env.
# Use ONE GitHub App, not a traditional OAuth App.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-decisionguard-app
GITHUB_APP_CLIENT_ID=replace-with-app-client-id
GITHUB_APP_CLIENT_SECRET=replace-with-app-client-secret
GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
GITHUB_APP_WEBHOOK_SECRET=replace-with-random-webhook-secret
GITHUB_APP_CALLBACK_URL=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:5173
OAUTH_SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
JWT_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///data/decisionguard.db
# Keep existing Neo4j, Azure OpenAI, retrieval, and storage settings.
