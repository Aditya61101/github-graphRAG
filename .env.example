# ---- Neo4j (Aura or local) ----
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ---- Which models the codegraph pipeline uses ----
# LLM_PROVIDER:       gemini | azure | fake   (fake = offline, no API calls)
# EMBEDDING_PROVIDER: gemini | azure | local | hash
#   local = sentence-transformers (downloads LOCAL_EMBEDDING_MODEL once)
#   hash  = offline bag-of-words, for tests/demos without network only
# Changing the embedding model later requires: codegraph reset-embeddings
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ---- Azure OpenAI ----
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-08-01-preview

# ---- Local embeddings ----
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Tuning ----
# Doc->code vector links: keep the top K per section above this score.
# Run `codegraph calibrate --repo <name>` to choose the score for your model.
BRIDGE_TOP_K=3
BRIDGE_MIN_SCORE=0.75
# Parallel LLM calls during enrich (lower it if you hit rate limits)
LLM_CONCURRENCY=8

# ---- Legacy scripts (old pipeline) ----
GROQ_API_KEY=
