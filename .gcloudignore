# Cloud Build source uploads are filtered independently of Docker.
# Only the current build configuration and backend inputs are uploaded.
**
!Dockerfile
!cloudbuild.yaml
!.dockerignore
!backend/
!backend/pyproject.toml
!backend/uv.lock
!backend/api_services/
!backend/api_services/**
!backend/ai_services/
!backend/ai_services/**
!backend/shared/
!backend/shared/**

# Exclusions below override the source-directory inclusions.
**/.env
**/.env.*
**/*.env
**/secrets/**
**/credentials/**
**/*credentials*.json
**/token.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite*
**/data/**
**/repos/**
**/clones/**
**/repositories/**
**/.git/**
**/.venv/**
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.cache/**
**/.pytest_cache/**
**/.ruff_cache/**
**/.mypy_cache/**
**/.state/**
**/*.jsonl
**/*.log
**/*.zip
**/tests/**
**/build/**
**/dist/**
**/*.egg-info/**

**/.gcloudignore
**/.aws/**
**/.ssh/**
**/*service-account*.json
**/*service_account*.json
**/client_secret*.json
**/credentials.json
**/.coverage*
**/htmlcov/**
**/coverage/**
**/downloads/**
**/.ipynb_checkpoints/**
**/node_modules/**
**/*.tar
**/*.tar.gz
**/*.bak

# Also cover common extensionless keys, mixed-case key files and database dumps.
**/*.[pP][eE][mM]
**/*.[kK][eE][yY]
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/*.p8
**/*.der
**/*.sql
**/*.dump
**/*.backup
